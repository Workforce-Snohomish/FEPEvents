"<!DOCTYPE html>\n<html>\n\n<head>\n  <base target=\"_top\">\n  <style>\n  .carousel-wrapper {\n    position: relative;\n    display: flex;\n    align-items: center;\n    margin: 2rem;\n  }\n\n  .carousel {\n    list-style: none;\n    display: grid;\n    grid-auto-flow: column;\n    grid-auto-columns: 40%;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    gap: 1rem;\n    width: 100%;\n\n     \n    scrollbar-width: none;\n\n    &::-webkit-scrollbar {\n      display: none;\n    }\n\n    &>li {\n      padding: 0 0.5em;\n      border: 1px solid #ccc;\n      border-radius: 1em;\n      min-width: 40%;\n      scroll-snap-align: center;\n      display:flex;\n      flex-direction:column;\n      justify-content:space-between;\n    }\n\n    @media (max-width: 572px) {\n      grid-auto-columns: calc(100% - 1em);\n\n      &>li {\n        min-width: 100%;\n      }\n    }\n\n  }\n \n  .carousel-btn {\n    position: absolute;\n    z-index: 1;\n    background: none;\n    border: none;\n\n    &.prev {\n      left: -4rem;\n    }\n\n    &.next {\n      right: -4rem;\n    }\n  }\n\n  .icon {\n    width: 3em;\n    aspect-ratio: 1;\n    vertical-align: -0.125em;\n    fill: #058184;\n  }\n  .event-type {\n    position:relative;\n  }\n  .event-type::before {\n    content: \"Type: \";\n    font-weight:bold;\n  }\n</style></head>\n\n<body>\n  <div class=\"carousel-wrapper\">\n    <button class=\"carousel-btn prev\" aria-label=\"Previous\">\n    <svg class=\"icon\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 640 640\"><path d=\"M320 576C461.4 576 576 461.4 576 320C576 178.6 461.4 64 320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576zM199 303L279 223C288.4 213.6 303.6 213.6 312.9 223C322.2 232.4 322.3 247.6 312.9 256.9L273.9 295.9L424 295.9C437.3 295.9 448 306.6 448 319.9C448 333.2 437.3 343.9 424 343.9L273.9 343.9L312.9 382.9C322.3 392.3 322.3 407.5 312.9 416.8C303.5 426.1 288.3 426.2 279 416.8L199 336.8C189.6 327.4 189.6 312.2 199 302