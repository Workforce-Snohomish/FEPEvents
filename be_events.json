p>\n          <p class=\"event-type type-class-employerOfTheDay\">\n                          Employer of the Day                        </p>\n                        <p class=\"event-description\">ABM Industries Employer of the Day. Hiring for industrial warehouse cleaning roles. Pay starts at $24/hour and increases to $27/hour...</p>\n                    </div>\n              </li>\n            <li>\n        <div class=\"event-body\">\n          <h2>Maritime Institute Meet the Trainer — Mariner Bootcamp</h2>\n          <p class=\"event-date\">Monday January 11, 2027 12:00 PM - 1:30 PM</p>\n          <p class=\"event-type type-class-employerOfTheDay\">\n                          Employer of the Day                        </p>\n                    </div>\n              </li>\n          </ul>\n    <button class=\"carousel-btn next\" aria-label=\"Next\">\n    <svg class=\"icon\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 640 640\"><path d=\"M320 576C461.4 576 576 461.4 576 320C576 178.6 461.4 64 320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576zM361 417C351.6 426.4 336.4 426.4 327.1 417C317.8 407.6 317.7 392.4 327.1 383.1L366.1 344.1L216 344.1C202.7 344.1 192 333.4 192 320.1C192 306.8 202.7 296.1 216 296.1L366.1 296.1L327.1 257.1C317.7 247.7 317.7 232.5 327.1 223.2C336.5 213.9 351.7 213.8 361 223.2L441 303.2C450.4 312.6 450.4 327.8 441 337.1L361 417.1z\"/></svg>\n  </button>\n  </div>\n\n  <script type=\"text/javascript\">\nconst carousel = document.querySelector('.carousel');\nconst carouselWrapper = document.querySelector('.carousel-wrapper');\nconst items = [...carousel.querySelectorAll('li')];\nconst prevBtn = document.querySelector('.carousel-btn.prev');\nconst nextBtn = document.querySelector('.carousel-btn.next');\nconst carouselSpeed = 4000; // 4 seconds\n\nlet currentIndex = 0;\nlet autoAdvance;\n\nconst scrollToIndex = (index) => {\n  if (index < 0) index = items.length - 1;\n  if (index >= items.length) index = 0;\n\n  currentIndex = index;\n  const marginLeft = parseFloat(getComputedStyle(carouselWrapper).marginLeft) || 0;\n  carousel.scrollTo({ left: items[currentIndex].offsetLeft - marginLeft, behavior: 'smooth' });\n}\n\nconst startAutoAdvance = () => {\n  autoAdvance = setInterval(() => scrollToIndex(currentIndex + 1), carouselSpeed);\n};\n\nconst resetAutoAdvance = () => {\n  clearInterval(autoAdvance);\n  startAutoAdvance();\n};\n\nprevBtn.addEventListener('click', () => { scrollToIndex(currentIndex - 1); resetAutoAdvance(); });\nnextBtn.addEventListener('click', () => { scrollToIndex(currentIndex + 1); resetAutoAdvance(); });\n\nif (items.length>2) {\n  startAutoAdvance();\n}\n</script></body>\n\n</html>"